{
  "name": "interprete",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "node scripts/dev-server.mjs --desktop",
    "dev:landing": "pnpm --filter @interprete/landing dev --strictPort",
    "dev:server": "node scripts/dev-server.mjs",
    "db:studio": "pnpm --filter @interprete/server db:studio",
    "dev:desktop": "pnpm --filter @interprete/desktop tauri dev",
    "build:server": "pnpm --filter @interprete/server build",
    "build:desktop": "pnpm --filter @interprete/desktop tauri build",
    "build:desktop:dmg": "pnpm build:desktop --target aarch64-apple-darwin --bundles dmg",
    "release": "gh workflow run release-macos.yml --ref main",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "node --test scripts/dev-config.test.mjs scripts/dev-server.test.mjs scripts/release-config.test.mjs scripts/publish-download.test.mjs && pnpm -r test",
    "benchmark": "node scripts/benchmark.mjs",
    "test:benchmark": "node --test scripts/*.test.mjs",
    "test:virtual-mic": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml audio_route::tests::virtual_microphone_loopback -- --ignored --exact --nocapture",
    "test:system-audio": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml system_audio::tests::system_audio_tap_delivers_frames -- --ignored --exact --nocapture"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=22"
  }
}
