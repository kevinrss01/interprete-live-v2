{
  "name": "interprete",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev:server": "pnpm --filter @interprete/server dev",
    "dev:desktop": "pnpm --filter @interprete/desktop tauri dev",
    "build:server": "pnpm --filter @interprete/server build",
    "build:desktop": "pnpm --filter @interprete/desktop tauri build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "benchmark": "node scripts/benchmark.mjs",
    "test:benchmark": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=22"
  }
}
