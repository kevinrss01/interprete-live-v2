# Copy to apps/server/.env.local and fill in. Names must match exactly:
# a misspelled key is silently ignored (e.g. ELEVEN_LABS_API_KEY is NOT read).

# Required. OpenAI: live transcription and translation.
INTERPRETER_OPENAI_API_KEY=
# Required. ElevenLabs (no underscore between ELEVEN and LABS): speech, voice cloning and deletion.
ELEVENLABS_API_KEY=
# Optional. Vercel AI Gateway for Jev (decides when a segment can be spoken early).
AI_GATEWAY_API_KEY=
# Required. Long random value used to sign sessions, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Account backend configuration for the full local development stack.
# pnpm dev:server starts the local database, runs migrations, then starts API + Studio.
DATABASE_URL=postgresql://interprete:interprete@localhost:5436/interprete
BETTER_AUTH_URL=http://localhost:3035
# Separate from SESSION_SECRET. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Optional. Origins allowed to call the API (CORS + session check). Defaults to the Tauri app and the Vite dev server.
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420
# Optional. Listening port, 3035 by default.
PORT=3035
