{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interprete",
  "version": "0.1.1",
  "identifier": "ai.impulselab.interprete",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Interprète",
        "width": 1280,
        "height": 820,
        "center": true,
        "minWidth": 420,
        "minHeight": 560,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "call-toast",
        "title": "Call detected",
        "url": "index.html#call-toast",
        "width": 400,
        "height": 326,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "acceptFirstMouse": true
      },
      {
        "label": "translation-overlay",
        "title": "Live translation",
        "url": "index.html#translation-overlay",
        "width": 376,
        "height": 116,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "backgroundThrottling": "disabled",
        "focusable": false,
        "acceptFirstMouse": true
      },
      {
        "label": "call-captions",
        "title": "Call captions",
        "url": "index.html#call-captions",
        "width": 980,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "backgroundThrottling": "disabled",
        "focusable": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "14.2",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 720, "height": 440 },
        "appPosition": { "x": 180, "y": 250 },
        "applicationFolderPosition": { "x": 540, "y": 250 }
      }
    }
  }
}
